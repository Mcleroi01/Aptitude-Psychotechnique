# ─────────────────────────────────────────────────────────────────────────────
# Aptitude Psychotechnique — variables d'environnement
# Copier ce fichier en ".env" (local) et renseigner les mêmes clés sur Vercel.
# Ne JAMAIS committer le fichier .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (Supabase → Project Settings → Database → Connect) ───────
# Connexion via le pooler en mode "Transaction" (port 6543), utilisée par l'application.
DATABASE_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connexion directe ou "Session" (port 5432), utilisée par les migrations et le seed.
DIRECT_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Authentification (Auth.js) ────────────────────────────────────────────────
# Secret de signature des sessions (32 caractères minimum).
# Générer avec : npx auth secret   ou   openssl rand -base64 32
AUTH_SECRET="remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum"
# URL publique de l'application (facultatif sur Vercel, détectée automatiquement).
# AUTH_URL="http://localhost:3000"

# ── Supabase Storage (Project Settings → API) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# Clé service_role : SERVEUR UNIQUEMENT. Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="remplacer-par-la-cle-service-role"

# ── E-mails (Resend → API Keys) ────────────────────────────────────────────────
# Facultatif en développement : sans clé, les liens s'affichent dans la console du serveur.
# RESEND_API_KEY="re_..."
# Expéditeur sur un domaine vérifié dans Resend.
# EMAIL_FROM="Aptitude Psychotechnique <noreply@votre-domaine.com>"
# URL publique utilisée dans les liens envoyés par e-mail (défaut : AUTH_URL ou URL Vercel).
# APP_URL="http://localhost:3000"

# ── Seed : premier compte super-administrateur (utilisé par `npm run db:seed`) ──────
SEED_ADMIN_NAME="Administrateur"
SEED_ADMIN_EMAIL="admin@exemple.cd"
# 12 caractères minimum. Le seed ne modifie jamais le mot de passe d'un compte existant.
SEED_ADMIN_PASSWORD="changer-ce-mot-de-passe"
